# Copy to .env.maps.local (Git-ignored) to enable Google Maps locally.
# Browser key: restrict Websites to local preview origins and API to Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is Google's documented development Map ID, not an API key.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Copy only these AI fields to .env.ai.local (Git-ignored).
# Never reuse editor/Conductor authentication tokens here.
TRAVEL_AI_API_KEY=
TRAVEL_AI_MODEL=gpt-4.1-mini
TRAVEL_AI_BASE_URL=https://api.openai.com/v1
TRAVEL_AI_PROVIDER=OpenAI

# Alternative: course-sponsored Alibaba Cloud Bailian Token Plan (no key in source).
# TRAVEL_AI_PROVIDER=Alibaba Cloud Bailian (course Group 21)
# TRAVEL_AI_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# TRAVEL_AI_MODEL=qwen3.8-flash
