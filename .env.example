# Copy to .env (Git-ignored) for backend and AI settings. Put the Google Maps
# key in .env.maps.local, which both the backend and the demo preview read.
# Never commit a filled copy.

# Backend server
HOST=127.0.0.1
PORT=8019

# Runtime state defaults to var/. Override only when you intentionally want
# another location; these paths are never served as static files.
# TMM_DB_PATH=var/travel.db
# TMM_MEDIA_DIR=var/media
# TMM_TMP_DIR=var/tmp

# AI memory provider. Leave empty to keep the honest 503 response.
# Set responses for Thomas's OpenAI-compatible adapter; keep real values in
# Git-ignored .env.ai.local or the server environment, not this file.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=60

# Google Maps (browser key). Restrict Websites to local preview origins and
# API to Maps JavaScript API.
GOOGLE_MAPS_API_KEY=
# DEMO_MAP_ID is Google's documented development Map ID, not an API key.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
