  "narrative": {
    "northStar": "The Open City Album",
    "overview": "A compact city index and a working map sit beside an open album. Warm paper, pale water, white controls and rust selection keep the place legible while photographs and personal text carry the memory. This is the implemented direction recorded for team review, not a claim of a separate user-approved brand system.\n\nFraunces gives city names and trip titles an album-like voice; system sans keeps navigation and metadata clear. The interface stays practical and quietly tactile: fine rules separate persistent regions, rounded cards hold individual trips, and small lifted controls sit above the map. The older green-led, Georgia-led catalogue treatment has been replaced.",
    "keyCharacteristics": [
      "A persistent city index coordinates map selection and the selected city’s memories.",
      "Locally bundled Fraunces headings with compact system sans controls.",
      "White cards and controls, warm paper albums, pale blue water and rust selection.",
      "Credited example photos and explicit fictional-trip labels remain visible."
    ],
    "rules": [
      {
        "name": "The Count Before Colour Rule",
        "body": "Every visit tier has a written legend, and saved visit totals remain visible in the index and album; colour never carries the count alone.",
        "section": "colors"
      },
      {
        "name": "The Album Voice Rule",
        "body": "Use Fraunces for the brand, city headings and memory titles; use system sans for controls, dates, counts and readable memory text.",
        "section": "typography"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Cards and persistent panels use borders and background tone. Reserve shadows for selected view controls, floating map controls and nearby-city choices.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve visible counts, keyboard selection, focus outlines and reduced-motion support.",
      "Do use the same selected city and drafts when switching Map and Album views.",
      "Do retain photo credits, fictional-story labels and useful memory text when media fails.",
      "Do let long city names and trip titles wrap without clipping.",
      "Do keep the complete photograph reachable from its cropped card cover."
    ],
    "donts": [
      "Don't reintroduce the replaced green-led catalogue styling or use Georgia as the primary display face.",
      "Don't imply that example photographs document fictional trips.",
      "Don't depict routes or add upload, cloud AI, SQLite or Google Maps functionality that is not integrated.",
      "Don't use decorative shadows on every card or add motion beyond the restrained marker state change."
    ]
  }
}
